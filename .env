# AwareNet Configuration
# Uncomment and set values to override defaults

# ── Panel Configuration ──
# SESSION_TIMEOUT=3600

# ── SMTP Configuration ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_SENDER_NAME=AwareNet
SMTP_SENDER_EMAIL=

# ── Security ──
# CORS_ORIGINS=*

# ── Licence / .exe (optionnel) ──
# Lien externe où le client obtient sa clé (bouton "Obtenir ma clé")
# AWARNET_KEY_URL=https://tonsite.com/get-key
# AWARNET_KEY_URL=https://example.com/get-awarenet-key
# Serveur de validation online (vide = offline/HWID) — ex: https://ton-serveur.com/validate
# AWARNET_LICENSE_SERVER=
# Secret HMAC pour clés offline (CHANGE-MOI avant de builder l'exe !)
# AWARNET_LICENSE_SECRET=AwareNet-2026-ChangeMe-SuperSecret-!42
# Duree licence en heures (24 par defaut, meme cle reactive 24h apres expiration)
# AWARNET_LICENSE_HOURS=24
# Platoboost (Linkvertise) — service 30939 par defaut
# USE_PLATOBOOST=1
# PLATOBOOST_SERVICE=30939
# PLATOBOOST_SECRET=da37cc11-80e6-4b87-a62b-24189044fcd6
# Bypass licence pour dev local
# AWARNET_NO_LICENSE=1
# Clé pré-remplie (évite de la saisir)
# AWARNET_LICENSE_KEY=AWARE-XXXX-XXXX-XXXX-XXXX
